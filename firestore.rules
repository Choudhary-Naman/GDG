rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // All reads/writes go through the Next.js server using the
      // firebase-admin SDK, which bypasses these rules. No client ever
      // needs direct Firestore access, so deny it outright.
      allow read, write: if false;
    }
  }
}
